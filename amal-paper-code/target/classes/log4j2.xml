<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <Routing name="PerRun">
            <Routes pattern="$${ctx:runId:-default}">
                <Route key="$${ctx:runId:-default}">
                    <File name="file-default"
                          fileName="${ctx:logDir:-.}/runner_log_default.log"
                          append="false">
                        <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n"/>
                    </File>
                </Route>
                <Route>
                    <File name="file-${ctx:runId:-default}"
                          fileName="${ctx:logDir:-.}/runner_log_${ctx:runId:-default}.log"
                          append="false">
                        <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n"/>
                    </File>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="PerRun"/>
        </Root>
    </Loggers>
</Configuration>